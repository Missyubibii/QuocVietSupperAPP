{
    "cli": {
        "version": ">= 7.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_USE_MOCK": "true"
            }
        },
        "production": {
            "node": "20.17.0",
            "autoIncrement": true,
            "android": {
                "buildType": "app-bundle"
            },
            "env": {
                "EXPO_PUBLIC_USE_MOCK": "false",
                "GRADLE_OPTS": "-Dorg.gradle.daemon=false"
            }
        }
    },
    "submit": {
        "production": {}
    }
}