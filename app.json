{
  "expo": {
    "name": "QUỐC VIỆT SUPER APP",
    "slug": "quoc-viet-super-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "quocvietsuperapp",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.qvc.quocvietsuperapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần truy cập camera để chụp ảnh chấm công xác nhận bạn đang có mặt tại văn phòng",
        "NSLocationWhenInUseUsageDescription": "Ứng dụng cần truy cập vị trí để xác nhận bạn đang ở trong phạm vi văn phòng khi chấm công",
        "NSFaceIDUsageDescription": "Sử dụng Face ID để đăng nhập nhanh và bảo mật tài khoản"
      }
    },
    "android": {
      "package": "com.qvc.quocvietsuperapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "254ec1fe-9141-46a8-ae48-986ea1f57c8e"
      }
    }
  }
}